{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Praxis : vérifier le lab",
      "detail": "Le lab du fichier ouvert : tests, outils, sanitizers",
      "type": "shell",
      "command": "python3",
      "args": ["${workspaceFolder}/praxis", "check", "${relativeFileDirname}"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Praxis : indice suivant",
      "detail": "Un indice pour le lab du fichier ouvert",
      "type": "shell",
      "command": "python3",
      "args": ["${workspaceFolder}/praxis", "hint", "${relativeFileDirname}"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Praxis : avancement",
      "type": "shell",
      "command": "python3",
      "args": ["${workspaceFolder}/praxis", "list"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ]
}
